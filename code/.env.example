# ====================================
# SENTINEL 环境变量配置模板
# ====================================
# 首次启动前复制此文件为 .env 并填写配置值
# 命令: cp .env.example .env

# LLM API 配置（必需）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 数据库密码（必需 - 请设置一个强密码）
# 如果删除数据卷后重启，确保使用相同的密码
POSTGRES_PASSWORD=

# Browser origins allowed by the API, comma separated.
CORS_ORIGINS=http://localhost:8080

# Dynamic sandbox. Keep false unless this host is a dedicated eBPF runner.
SANDBOX_ALLOW_PRIVILEGED=false
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_PACKAGE_TIMEOUT_SECONDS=30
