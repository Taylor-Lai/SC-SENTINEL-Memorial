# ====================================
# SENTINEL 环境变量配置模板
# ====================================
# 首次启动前复制此文件为 .env 并填写配置值
# 命令: cp .env.example .env

# LLM API 配置（可选；启用 LLM 增强时三项均需填写）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 数据库密码（必需 - 请设置一个强密码）
# 已有数据库卷不会随此处配置变化自动更新密码，请保留初始化时的配置
POSTGRES_PASSWORD=

# API 允许的浏览器来源，多个来源以逗号分隔
CORS_ORIGINS=http://localhost:8080

# 动态沙箱：除非使用专用隔离 eBPF 主机，否则保持非特权模式
SANDBOX_ALLOW_PRIVILEGED=false
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_PACKAGE_TIMEOUT_SECONDS=30
